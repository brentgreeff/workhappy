/ Submitted by the export Stimulus controller over fetch; Turbo is off so the page stays put
/ and the controller can poll the export into its ready state.
- field = "rounded border border-gray-300 px-3 py-2 dark:border-gray-700 dark:bg-gray-800"
= form_with model: export, url: exports_path, data: { turbo: false, controller: "export", action: "submit->export#submit" }, class: "mt-8 flex flex-wrap items-end gap-4" do |form|
  div
    = form.label :from_date, class: "block mb-1 text-sm"
    = form.date_field :from_date, class: field, data: { export_target: "from" }
  div
    = form.label :to_date, class: "block mb-1 text-sm"
    = form.date_field :to_date, class: field, data: { export_target: "to" }
  - if earliest
    button.js-export-all-time.text-sm.underline.pb-2 type="button" data-action="export#allTime" data-export-from-param=earliest.to_date.iso8601 data-export-to-param=latest.to_date.iso8601 All time
  div
    = form.label :status_filter, class: "block mb-1 text-sm"
    = form.select :status_filter, AssessmentStatus.options, { include_blank: "All statuses" }, class: field
  = form.button "Export CSV", type: "submit", class: "js-export-button cursor-pointer rounded bg-gray-900 px-4 py-2 text-white disabled:opacity-50 dark:bg-gray-100 dark:text-gray-900", data: { export_target: "button" }
  span.js-export-status.text-sm role="status" data-export-target="status"
  a.js-export-download.text-sm.underline hidden=true data-export-target="link" Download CSV
