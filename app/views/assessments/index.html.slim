= render "assessments/filter", filter: @filter, earliest: @earliest, latest: @latest

- if @assessments.any?
  table.js-assessments.mt-6.w-full.text-left.text-sm
    thead.text-gray-500 class="dark:text-gray-400"
      tr
        th.py-2.pr-4.font-normal Employee
        th.py-2.pr-4.font-normal Date
        th.py-2.pr-4.font-normal Status
        th.py-2.pr-4.font-normal Score
    tbody
      = render @assessments

  = render "assessments/pagination", filter: @filter, page: @page, pages: @pages
- elsif flash.now[:alert].blank?
  p.mt-6.text-sm.text-gray-500 class="dark:text-gray-400" No assessments match.
