/ One tab today. Matched on controller, not current_page?, so a filtered or paged list still
/ highlights it.
nav.js-main-nav.flex.gap-1.border-b.border-gray-200.px-4 class="dark:border-gray-700"
  - { "Assessments" => [root_path, "assessments"] }.each do |label, (path, section)|
    - active = controller_name == section
    = link_to label, path, class: "-mb-px border-b-2 px-4 py-2 text-sm #{active ? 'border-blue-600 font-semibold text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200'}", "aria-current": (active ? "page" : nil)
