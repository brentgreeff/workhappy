/ Every page behind require_authentication. The signed-out pages render layouts/authentication
/ instead, so Current.user is always present here and in everything this renders.
doctype html
html
  = render "layouts/head"

  body.min-h-screen.bg-white.text-gray-900 class="dark:bg-gray-900 dark:text-gray-100"
    = render layout: "layouts/header" do
      span.text-sm.text-gray-500 class="dark:text-gray-400" = Current.user.email_address
      = render "layouts/theme_menu"
      = button_to "Sign out", session_path, method: :delete, class: "js-sign-out cursor-pointer text-sm underline"

    #js-flash.container.mx-auto.px-5
      = render "layouts/flash"

    main.container.mx-auto.mt-8.px-5.pb-16
      = yield
