.relative.inline-block.group.js-theme-menu data-controller="theme"
  button.p-1.text-gray-500 class="hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" type="button" aria-label="Theme menu"
    = render "icons/sun", classes: "h-8 w-8 dark:hidden"
    = render "icons/moon", classes: "h-8 w-8 hidden dark:block"
  .hidden.absolute.right-0.top-full.z-10.w-40.rounded-md.border.border-gray-200.bg-white.py-1.shadow-lg class="group-hover:block dark:border-gray-700 dark:bg-gray-800" role="menu"
    - { light: "Light", dark: "Dark", system: "System" }.each do |choice, label|
      button.block.w-full.px-4.py-2.text-left class="hover:bg-gray-100 dark:hover:bg-gray-700 aria-checked:font-semibold" type="button" role="menuitemradio" data-theme-target="choice" data-theme-choice-param=choice data-action="theme#select" = label
